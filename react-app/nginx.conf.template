server {
    listen ${PORT};
    server_name _;

    # Login sessions are per host. Keep everyone on one host so a session
    # created on afc.com.ng is not missing on www.afc.com.ng.
    if ($host = www.afc.com.ng) {
        return 301 https://afc.com.ng$request_uri;
    }
    root /usr/share/nginx/html;
    index index.html;

    location = / {
        try_files /index.html =404;
    }

    # React's chef image is bundled under dist/images; serve it locally.
    location /images/ {
        try_files $uri =404;
    }

    # Vite emits the React JS/CSS bundles under /assets. Serve those locally;
    # only fall back to Laravel for assets that are not part of the React build.
    location /assets/ {
        try_files $uri @laravel;
    }

    # React uses /brand/... for Laravel-hosted brand assets.
    location /brand/ {
        proxy_pass ${BACKEND_URL}/assets/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    # Keep API requests on the Laravel service.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    # Laravel-rendered pages (login, staff dashboards, auth flows) and their
    # built assets. Everything else is a React route.
    location ~ ^/(login|logout|register|forgot-password|reset-password|verify-email|confirm-password|password|email|admin|manager|pos|staff|inventory|kitchen|print|profile|receipt|build|storage|sanctum|up)(/|$) {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Keep redirects (e.g. login -> admin) on the public domain.
        proxy_redirect ${BACKEND_URL}/ https://$host/;

        # Laravel builds absolute links (route()) from the backend host, which
        # would open on a domain without the user's session. Rewrite them.
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter '${BACKEND_URL}' 'https://$host';
    }

    # React client-side routes must resolve to the SPA, not Laravel.
    location / {
        try_files $uri /index.html;
    }

    # Fallback for non-React assets that are stored on Laravel.
    location @laravel {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = / {
        try_files /index.html =404;
    }

    # React's chef image is bundled under dist/images; serve it locally.
    location /images/ {
        try_files $uri =404;
    }

    # Vite emits the React JS/CSS bundles under /assets. Serve those locally;
    # only fall back to Laravel for assets that are not part of the React build.
    location /assets/ {
        try_files $uri @laravel;
    }

    # React uses /brand/... for Laravel-hosted brand assets.
    location /brand/ {
        proxy_pass ${BACKEND_URL}/assets/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    # Keep API requests on the Laravel service.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    # React client-side routes must resolve to the SPA, not Laravel.
    location / {
        try_files $uri /index.html;
    }

    # Fallback for non-React assets that are stored on Laravel.
    location @laravel {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }
}
